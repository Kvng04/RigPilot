rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAppHQOwner() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/settings/app_config) &&
        get(/databases/$(database)/documents/settings/app_config).data.ownerUid == request.auth.uid;
    }

    function isValidLead(data) {
      return data.email is string &&
        data.email.size() >= 3 &&
        data.email.size() <= 150 &&
        data.source is string &&
        data.source.size() <= 100 &&
        data.timestamp is string;
    }

    // Lead capture collection (Public landing page lead capture)
    match /leads/{leadId} {
      allow create: if isValidLead(request.resource.data);
      allow read, update, delete: if isAppHQOwner();
    }

    // Launch HQ settings & owner document
    match /settings/{settingId} {
      allow get: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerEmail is string &&
        request.resource.data.claimedAt is string &&
        !exists(/databases/$(database)/documents/settings/app_config);
      allow update: if isSignedIn() &&
        resource.data.ownerUid == request.auth.uid &&
        request.resource.data.ownerUid == request.auth.uid;
      allow list, delete: if false;
    }

    // User profile and private workspace data
    match /users/{userId} {
      // User profile document (Tolerates null displayName for Google sign-in)
      allow read, write: if isOwner(userId);

      match /profile/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Private shift audit reports
      match /audits/{auditId} {
        allow read, write: if isOwner(userId);
      }

      // Private fleet machinery inventory
      match /machines/{machineId} {
        allow read, write: if isOwner(userId);
      }

      // Private user analytics events
      match /events/{eventId} {
        allow create, read: if isOwner(userId);
        allow update, delete: if false;
      }
    }
  }
}
